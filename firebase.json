{
  "hosting": [
    {
      "target": "imovel-facil",
      "public": "dist/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/**/!(index.html|*.html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "imovel-facil-backend",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/",
          "run": {
            "serviceId": "imovel-facil-backend",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/imovel/**",
          "run": {
            "serviceId": "imovel-facil-backend",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/contato",
          "run": {
            "serviceId": "imovel-facil-backend",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/proprietario",
          "run": {
            "serviceId": "imovel-facil-backend",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "**",
          "destination": "/app.html"
        }
      ]
    },
    {
      "target": "imoviu",
      "public": "imoviu_app/static",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "imoviu-backend",
            "region": "southamerica-east1"
          }
        }
      ]
    }
  ]
}
